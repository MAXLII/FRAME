<Window x:Class="Frame.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FRAME · 设备诊断工作台" Width="1360" Height="900" MinWidth="1040" MinHeight="700" Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#102A43" Padding="22,12">
      <DockPanel>
        <Button x:Name="SidebarToggle" DockPanel.Dock="Left" Content="☰" ToolTip="收起侧边栏" Click="ToggleSidebar" Width="38" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="ConnectionType" Width="125" Margin="0,0,10,6" Padding="5" SelectionChanged="ChangeConnectionType" SelectedIndex="0"><ComboBoxItem Content="串口"/><ComboBoxItem Content="以太网 TCP"/></ComboBox>
          <StackPanel x:Name="SerialSettings" Orientation="Horizontal">
            <Grid Width="270" Margin="0,0,10,6">
              <ComboBox x:Name="Port" IsEditable="True" DisplayMemberPath="Display" TextSearch.TextPath="Display" Margin="0" Padding="5" ToolTip="串口端口及设备名称；更换后自动断开" SelectionChanged="ChangePort" LostKeyboardFocus="CommitPort" KeyDown="PortKeyDown"/>
            </Grid>
            <ComboBox x:Name="Baud" IsEditable="True" Text="115200" Width="125" Margin="0,0,10,6" Padding="5" ToolTip="波特率；选取预设立即生效，自定义输入后回车或离开输入框生效" SelectionChanged="ChangeBaud" LostKeyboardFocus="CommitBaud" KeyDown="BaudKeyDown"/>
            <Button Content="刷新端口" Click="RefreshPorts"/>
          </StackPanel>
          <StackPanel x:Name="TcpSettings" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock Text="IP" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,6"/>
            <TextBox x:Name="TcpHost" Text="192.168.1.10" Width="155" Margin="0,0,10,6" ToolTip="设备 IPv4 或 IPv6 地址"/>
            <TextBlock Text="端口" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,6"/>
            <TextBox x:Name="TcpPort" Text="9000" Width="65" Margin="0,0,10,6"/>
            <Button x:Name="SearchEthernetButton" Content="搜索设备" Click="SearchEthernet"/>
          </StackPanel>
          <TextBlock Text="地址" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,6"/><TextBox x:Name="Address" Text="2" Width="45" Margin="0,0,10,6"/>
          <TextBlock Text="Dyn" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,6"/><TextBox x:Name="DynamicAddress" Text="0" Width="40" Margin="0,0,10,6" ToolTip="动态地址（0–255），连接时生效"/>
          <Button x:Name="ConnectButton" Content="连接" Click="ToggleConnection" Width="90"/>
          <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12" Fill="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,6" ToolTip="未连接" AutomationProperties.Name="未连接"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="185"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
        <DockPanel Margin="5,20">
          <ListBox x:Name="Navigation" BorderThickness="0" SelectionChanged="Navigate" FontSize="15" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ToolTip" Value="{Binding Title}"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                <Style.Triggers><DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Padding" Value="7,13"/></DataTrigger></Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <TextBlock x:Name="NavigationText" Text="{Binding Title}" VerticalAlignment="Center"/>
                  <Path x:Name="NavigationIcon" Data="{Binding Icon}" Width="23" Height="23" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="NavigationText" Property="Visibility" Value="Collapsed"/><Setter TargetName="NavigationIcon" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel x:Name="PageHeading" Margin="0,0,0,15"><TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold" Foreground="#102A43"/><TextBlock x:Name="PageHint" Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
        <ContentControl x:Name="Form" Grid.Row="1"/>
        <ContentControl x:Name="PageBody" Grid.Row="2"/>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#E7EEF5" Padding="16,5" MinHeight="34">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="未连接" MaxWidth="600" Foreground="#334155" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock x:Name="Feedback" Grid.Column="1" Margin="16,0,0,0" Height="22" VerticalAlignment="Center" Foreground="#334155" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000">
          <TextBlock.ToolTip><ToolTip><TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}" TextWrapping="Wrap" MaxWidth="800"/></ToolTip></TextBlock.ToolTip>
        </TextBlock>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
        <TextBlock x:Name="WaveCursor" Foreground="#334155" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel x:Name="JobControls" Orientation="Horizontal" Visibility="Collapsed" Margin="12,0,0,0">
          <TextBlock Text="后台任务" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="JobList" Width="230" DisplayMemberPath="Label" Padding="5,2" ToolTip="查看后台任务"/>
        </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
